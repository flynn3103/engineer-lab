stateDiagram-v2
  direction TB
  state "Planned" as Planned
  state "Streaming" as Streaming
  state "Caught up" as Ready
  state "Reads new, writes both" as ReadsNew
  state "Reads and writes new" as UseNew
  state "Old replica retired" as Retired
  [*] --> Planned: balancer selects move
  Planned --> Streaming: dual writes, reads old
  Streaming --> Ready: copy done, writes applied
  Ready --> ReadsNew: switch read set
  ReadsNew --> UseNew: use_new transition
  UseNew --> Retired: cleanup leaving replica
  Retired --> [*]
